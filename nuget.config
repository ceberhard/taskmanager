<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This project only needs public packages. Clearing inherited sources keeps
       restores from failing on private feeds that require sign-in. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
