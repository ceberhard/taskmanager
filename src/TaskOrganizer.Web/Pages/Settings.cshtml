@page
@model SettingsModel
@{
    ViewData["Title"] = "Settings";
    AppSettings current = Model.Current;
}

<h1 class="h3">Settings</h1>

<section class="mb-4">
    <h2 class="h5">Targets</h2>
    <form method="post" asp-page-handler="Save" class="row g-3" style="max-width: 46rem">
        <div class="col-sm-6">
            <label class="form-label" for="dailyPlanTargetHours">Daily plan target (hours)</label>
            <input type="number" id="dailyPlanTargetHours" name="dailyPlanTargetHours" value="@Display.NumberInput(current.DailyPlanTargetHours)" min="0.25" max="24" step="0.25" class="form-control" required />
            <div class="form-text">Today warns when planned task hours go past this.</div>
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="weeklyGoalHours">Weekly goal (hours)</label>
            <input type="number" id="weeklyGoalHours" name="weeklyGoalHours" value="@Display.NumberInput(current.WeeklyGoalHours)" min="1" max="168" step="0.25" class="form-control" required />
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="openingRolloverHours">Opening rollover balance (hours)</label>
            <input type="number" id="openingRolloverHours" name="openingRolloverHours" value="@Display.NumberInput(current.OpeningRolloverHours)" step="0.01" class="form-control" required />
            <div class="form-text">The Rollover figure from your spreadsheet. Positive means ahead of goal.</div>
        </div>
        <div class="col-sm-6">
            <label class="form-label" for="rolloverStartDate">Count rollover from (optional)</label>
            <input type="date" id="rolloverStartDate" name="rolloverStartDate" value="@Display.DateInput(current.RolloverStartDate)" class="form-control" />
            <div class="form-text">Weeks before this date are ignored. Leave empty to count every logged week.</div>
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</section>

<section class="mb-4">
    <h2 class="h5">Suggested days</h2>
    <form method="post" asp-page-handler="SaveSuggestion" class="row g-3" style="max-width: 46rem">
        <div class="col-sm-4">
            <label class="form-label" for="focusSharePercent">Focus share (%)</label>
            <input type="number" id="focusSharePercent" name="focusSharePercent" value="@current.FocusSharePercent" min="0" max="100" step="5" class="form-control" required />
            <div class="form-text">Part of a suggested day given to the focus projects.</div>
        </div>
        <div class="col-sm-4">
            <label class="form-label" for="assumedUnsizedHours">Assumed size (hours)</label>
            <input type="number" id="assumedUnsizedHours" name="assumedUnsizedHours" value="@Display.NumberInput(current.AssumedUnsizedHours)" min="0.25" max="24" step="0.25" class="form-control" required />
            <div class="form-text">What a task with no size counts as.</div>
        </div>
        <div class="col-sm-4">
            <label class="form-label" for="dueSoonWorkingDays">Due soon (working days)</label>
            <input type="number" id="dueSoonWorkingDays" name="dueSoonWorkingDays" value="@current.DueSoonWorkingDays" min="0" max="30" step="1" class="form-control" required />
            <div class="form-text">Tasks due within this window are pulled forward.</div>
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</section>

<section class="mb-4" id="integrations">
    <h2 class="h5">Integrations</h2>
    <p class="small text-muted mb-2">
        Tokens are encrypted for this Windows user and kept outside the app and its database, in <code>@Model.CredentialFolder</code>.
        They are never shown again; leave a token box empty to keep the saved one. Both integrations only read: nothing is ever changed in Jira or Azure DevOps.
    </p>

    <h3 class="h6 mt-3">Jira</h3>
    <form method="post" asp-page-handler="SaveJira" class="row g-2 align-items-end" style="max-width: 52rem">
        <div class="col-sm-5">
            <label class="form-label small" for="jiraSiteUrl">Site address</label>
            <input id="jiraSiteUrl" name="jiraSiteUrl" value="@current.JiraSiteUrl" class="form-control form-control-sm" placeholder="https://yourcompany.atlassian.net" required />
        </div>
        <div class="col-sm-3">
            <label class="form-label small" for="jiraEmail">Your Jira email</label>
            <input id="jiraEmail" name="jiraEmail" type="email" value="@current.JiraEmail" class="form-control form-control-sm" required />
        </div>
        <div class="col-sm-4">
            <label class="form-label small" for="jiraApiToken">API token @(Model.HasJiraToken ? "(saved)" : "(not set)")</label>
            <input id="jiraApiToken" name="jiraApiToken" type="password" class="form-control form-control-sm" autocomplete="off"
                   placeholder="@(Model.HasJiraToken ? "leave empty to keep" : "paste token")" />
        </div>
        <div class="col-12 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-sm btn-primary">Save Jira</button>
            <button type="submit" asp-page-handler="TestJira" formnovalidate class="btn btn-sm btn-outline-secondary">Test connection</button>
            @if (Model.HasJiraToken)
            {
                <button type="submit" asp-page-handler="RemoveJiraToken" formnovalidate class="btn btn-sm btn-outline-danger">Remove token</button>
            }
        </div>
    </form>
    <p class="small text-muted mt-1 mb-2">Create a token at id.atlassian.com, under Security, API tokens.</p>

    <div class="mb-3" style="max-width: 36rem">
        <div class="small fw-semibold mb-1">Ticket prefix to project</div>
        @foreach (JiraProjectMapping mapping in Model.JiraMappings)
        {
            <form method="post" asp-page-handler="RemoveJiraMapping" class="d-flex gap-2 align-items-center mb-1">
                <input type="hidden" name="id" value="@mapping.Id" />
                <span class="flex-grow-1"><strong>@mapping.Prefix</strong> → @mapping.Project?.Name</span>
                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove mapping @mapping.Prefix">Remove</button>
            </form>
        }
        <form method="post" asp-page-handler="AddJiraMapping" class="d-flex gap-2 mt-1">
            <input name="prefix" class="form-control form-control-sm w-auto" placeholder="ROC" maxlength="20" required aria-label="Jira prefix" />
            <select name="projectId" class="form-select form-select-sm w-auto" aria-label="Project for this prefix" required>
                @foreach (Project project in Model.Projects)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Add</button>
        </form>
        <div class="form-text">Tickets with a prefix not listed here go to Unfiled.</div>
    </div>

    <h3 class="h6 mt-3">Azure DevOps pull requests</h3>
    <form method="post" asp-page-handler="SaveAzureDevOps" class="row g-2 align-items-end" style="max-width: 52rem">
        <div class="col-sm-5">
            <label class="form-label small" for="azureDevOpsOrganizationUrl">Organisation address</label>
            <input id="azureDevOpsOrganizationUrl" name="azureDevOpsOrganizationUrl" value="@current.AzureDevOpsOrganizationUrl" class="form-control form-control-sm" placeholder="https://dev.azure.com/yourorganisation" required />
        </div>
        <div class="col-sm-3">
            <label class="form-label small" for="azureDevOpsProject">Project (optional)</label>
            <input id="azureDevOpsProject" name="azureDevOpsProject" value="@current.AzureDevOpsProject" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-4">
            <label class="form-label small" for="azureDevOpsToken">Personal access token @(Model.HasAzureDevOpsToken ? "(saved)" : "(not set)")</label>
            <input id="azureDevOpsToken" name="azureDevOpsToken" type="password" class="form-control form-control-sm" autocomplete="off"
                   placeholder="@(Model.HasAzureDevOpsToken ? "leave empty to keep" : "paste token")" />
        </div>
        <div class="col-12 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-sm btn-primary">Save Azure DevOps</button>
            <button type="submit" asp-page-handler="TestAzureDevOps" formnovalidate class="btn btn-sm btn-outline-secondary">Test connection</button>
            @if (Model.HasAzureDevOpsToken)
            {
                <button type="submit" asp-page-handler="RemoveAzureDevOpsToken" formnovalidate class="btn btn-sm btn-outline-danger">Remove token</button>
            }
        </div>
    </form>
    <p class="small text-muted mt-1 mb-2">Create the token in Azure DevOps under User settings, Personal access tokens, with the Code (Read) scope only.</p>

    <form method="post" asp-page-handler="SavePullRequestDefaults" class="d-flex flex-wrap gap-2 align-items-end" style="max-width: 52rem">
        <div>
            <label class="form-label small" for="pullRequestProjectId">Pull request tasks go under</label>
            <select id="pullRequestProjectId" name="pullRequestProjectId" class="form-select form-select-sm">
                <option value="">Unfiled</option>
                @foreach (Project project in Model.Projects)
                {
                    <option value="@project.Id" selected="@(project.Id == current.PullRequestProjectId)">@project.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small" for="pullRequestDefaultHours">Size (hours)</label>
            <input id="pullRequestDefaultHours" name="pullRequestDefaultHours" type="number" min="0.25" step="0.25" value="@Display.NumberInput(current.PullRequestDefaultHours)" class="form-control form-control-sm hours-input" required />
        </div>
        <div>
            <label class="form-label small" for="pullRequestDefaultPriority">Priority</label>
            <select id="pullRequestDefaultPriority" name="pullRequestDefaultPriority" class="form-select form-select-sm">
                @foreach (TaskPriority priority in Display.Priorities)
                {
                    <option value="@priority" selected="@(priority == current.PullRequestDefaultPriority)">@Display.Priority(priority)</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Save defaults</button>
    </form>
</section>

<section class="mb-4" id="hold-reason-settings">
    <h2 class="h5">Hold reasons</h2>
    <p class="small text-muted mb-2">Offered while you type why a task is on hold. You can always type something else; removing one here does not change tasks already on hold.</p>
    @foreach (HoldReasonSuggestion reason in Model.HoldReasons)
    {
        <form method="post" asp-page-handler="RemoveHoldReason" class="d-flex gap-2 align-items-center mb-1" style="max-width: 30rem">
            <input type="hidden" name="id" value="@reason.Id" />
            <span class="flex-grow-1">@reason.Text</span>
            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove @reason.Text">Remove</button>
        </form>
    }
    <form method="post" asp-page-handler="AddHoldReason" class="d-flex gap-2 mt-2" style="max-width: 30rem">
        <input name="text" class="form-control form-control-sm" required maxlength="200" placeholder="New hold reason" aria-label="New hold reason" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Add</button>
    </form>
</section>

<section class="mb-4">
    <h2 class="h5">Projects</h2>
    @foreach (Project project in Model.Projects)
    {
        <form method="post" asp-page-handler="RenameProject" class="d-flex gap-2 mb-1" style="max-width: 30rem">
            <input type="hidden" name="id" value="@project.Id" />
            <input name="name" value="@project.Name" class="form-control form-control-sm" required maxlength="100" aria-label="Project name" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Rename</button>
        </form>
    }
    <form method="post" asp-page-handler="AddProject" class="d-flex gap-2 mt-2" style="max-width: 30rem">
        <input name="name" class="form-control form-control-sm" required maxlength="100" placeholder="New project name" aria-label="New project name" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Add</button>
    </form>
</section>

<section class="mb-4">
    <h2 class="h5">Import from spreadsheet</h2>
    <p class="small text-muted mb-2">
        Reads the "@PunchdownImporter.SheetName" sheet of <code>@Model.WorkbookPath</code>. The workbook is only read, never changed.
        Running it again adds only rows that were not imported before.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <form method="post" asp-page-handler="Import">
            <button type="submit" class="btn btn-outline-primary">Import punch-down list</button>
        </form>
        <form method="post" asp-page-handler="ImportTime">
            <button type="submit" class="btn btn-outline-primary">Import time log</button>
        </form>
    </div>
    <p class="small text-muted mt-2 mb-0">
        The time import reads the start and end times from the "@TimeLogImporter.SheetName" sheet. Rows with no end time, and rows in the undated weekend block, are skipped and listed.
    </p>
    @if (Model.OfferedRolloverHours is double offered)
    {
        <form method="post" asp-page-handler="ApplyRollover" class="alert alert-info d-flex flex-wrap gap-2 align-items-center mt-2 mb-0">
            <input type="hidden" name="hours" value="@offered.ToString("R", System.Globalization.CultureInfo.InvariantCulture)" />
            <span>The sheet's Rollover is @Display.SignedHours(offered). Your opening rollover balance is @Display.SignedHours(Model.Current.OpeningRolloverHours).</span>
            <button type="submit" class="btn btn-sm btn-primary">Set opening balance to @Display.SignedHours(offered)</button>
        </form>
    }
</section>
