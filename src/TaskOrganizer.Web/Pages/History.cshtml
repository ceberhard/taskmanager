@page
@model HistoryModel
@{
    ViewData["Title"] = "Task history";
    WorkTask task = Model.Item;
}

<p class="small mb-2"><a asp-page="/Backlog">&laquo; Backlog</a> · <a asp-page="/Index">Today</a></p>
<h1 class="h4">@Display.Linkify(task.Title)</h1>
<p class="text-muted">
    @(task.Project?.Name ?? "Unfiled") · @Display.Priority(task.Priority) · now <strong>@Display.Status(task.Status)</strong>
    @if (task.HoldReason is not null)
    {
        <span>: @task.HoldReason</span>
    }
</p>

<table class="table table-sm align-middle w-auto" id="task-history">
    <thead>
        <tr><th>When</th><th>What changed</th><th>Reason</th></tr>
    </thead>
    <tbody>
        @foreach (HistoryEvent entry in Model.Events)
        {
            <tr>
                <td class="text-nowrap">@entry.LocalTime.ToString("ddd d MMM yyyy HH:mm")</td>
                <td>@entry.What</td>
                <td>@entry.Note</td>
            </tr>
        }
    </tbody>
</table>
