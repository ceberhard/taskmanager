@model TaskRowModel
@{
    WorkTask task = Model.Task;
    string holdButton = task.Status == WorkTaskStatus.OnHold ? "Update hold" : "Put on hold";
}
<li class="task-row @Display.StateCss(task.Status)">
    <form method="post" class="task-row-main">
        <input type="hidden" name="id" value="@task.Id" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <span class="prio @Display.PriorityCss(task.Priority)">@Display.Priority(task.Priority)</span>
        <div class="task-body">
            <div class="task-title @(task.IsClosed ? "text-decoration-line-through text-muted" : "")">
                @switch (task.Status)
                {
                    case WorkTaskStatus.InProgress:
                        <span class="badge state-badge state-in-progress">IN PROGRESS</span>
                        break;
                    case WorkTaskStatus.OnHold:
                        <span class="badge state-badge state-on-hold">ON HOLD: @task.HoldReason</span>
                        break;
                    case WorkTaskStatus.DoneForToday:
                        <span class="badge state-badge state-done-for-today">DONE FOR TODAY</span>
                        break;
                }
                @Display.Linkify(task.Title)
            </div>
            <div class="task-meta">
                @if (Model.ShowProject)
                {
                    <span>@(task.Project?.Name ?? "Unfiled")</span>
                    <span> · </span>
                }
                <span>@Display.Status(task.Status)</span>
                @if (task.EstimateHours is double hours)
                {
                    <span> · @Display.Hours(hours)</span>
                }
                else if (task.IsWorkable)
                {
                    <span> · unsized</span>
                }
                @if (task.DueDate is DateOnly due)
                {
                    <span class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")"> · due @due.ToString("ddd d MMM")</span>
                }
                @if (task.Source != TaskSource.Manual)
                {
                    <span> · @task.Source.ToString().ToLowerInvariant()</span>
                }
                @if (task.IsWorkable && Model.IsPlannedToday)
                {
                    <span class="text-primary"> · planned today</span>
                }
                @if (Model.IsCarriedOver)
                {
                    <span class="text-danger"> · carried over from @task.PlannedFor!.Value.ToString("ddd d MMM")</span>
                }
                @if (task.Status == WorkTaskStatus.OnHold)
                {
                    @if (task.HoldCheckBackOn is DateOnly checkBack)
                    {
                        <span class="@(Model.IsFollowUpDue ? "text-danger fw-semibold" : "")"> · @(Model.IsFollowUpDue ? "follow up was due" : "check back") @checkBack.ToString("ddd d MMM")</span>
                    }
                    else
                    {
                        <span> · no check-back date</span>
                    }
                }
            </div>
        </div>
        <div class="task-actions">
            @if (task.IsWorkable)
            {
                @if (Model.OfferDoneForToday)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="DoneForToday" class="btn btn-sm btn-success" title="Finished for today; you sign it off tomorrow">Done for today</button>
                    <button type="submit" asp-page="/Actions" asp-page-handler="Complete" class="btn btn-sm btn-outline-success" title="Finished, no second look needed">Done</button>
                }
                else
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="Complete" class="btn btn-sm btn-success">Done</button>
                }
                @if (!Model.IsPlannedToday)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="PlanToday" class="btn btn-sm btn-outline-primary">Today</button>
                }
                @if (task.PlannedFor is not null)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="ToBacklog" class="btn btn-sm btn-outline-secondary">Backlog</button>
                }
                @if (task.Status == WorkTaskStatus.ToDo)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="Start" class="btn btn-sm btn-outline-secondary">Start</button>
                }
                else
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="Pause" class="btn btn-sm btn-outline-secondary">Pause</button>
                }
                <button type="submit" asp-page="/Actions" asp-page-handler="Drop" class="btn btn-sm btn-outline-danger" title="Close without doing it">Drop</button>
            }
            else if (task.Status == WorkTaskStatus.OnHold)
            {
                <button type="submit" asp-page="/Actions" asp-page-handler="Resume" class="btn btn-sm btn-primary" title="Take it off hold">Resume</button>
                <button type="submit" asp-page="/Actions" asp-page-handler="Complete" class="btn btn-sm btn-outline-success">Done</button>
                <button type="submit" asp-page="/Actions" asp-page-handler="Drop" class="btn btn-sm btn-outline-danger" title="Close without doing it">Drop</button>
            }
            else if (task.Status == WorkTaskStatus.DoneForToday)
            {
                <button type="submit" asp-page="/Actions" asp-page-handler="Complete" class="btn btn-sm btn-success" title="Sign it off; it leaves the list">Done</button>
                <button type="submit" asp-page="/Actions" asp-page-handler="ReopenForToday" class="btn btn-sm btn-outline-primary" title="Not finished; back into today's work">Re-open for today</button>
                <button type="submit" asp-page="/Actions" asp-page-handler="ToBacklog" class="btn btn-sm btn-outline-secondary" title="More to do, but not today">Backlog</button>
            }
            else
            {
                <button type="submit" asp-page="/Actions" asp-page-handler="Reopen" class="btn btn-sm btn-outline-secondary">Reopen</button>
            }
        </div>
    </form>
    @if (task.IsOpen)
    {
        <details class="task-more">
            <summary>Edit, hold, more</summary>
            <form method="post" asp-page="/Actions" asp-page-handler="Edit" class="d-flex flex-wrap gap-2 align-items-center mt-1">
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input name="title" value="@task.Title" class="form-control form-control-sm quick-title" required maxlength="1000" aria-label="Task title" />
                <select name="projectId" class="form-select form-select-sm w-auto" aria-label="Project">
                    <option value="">Unfiled</option>
                    @foreach (Project project in Model.Projects)
                    {
                        <option value="@project.Id" selected="@(project.Id == task.ProjectId)">@project.Name</option>
                    }
                </select>
                <select name="priority" class="form-select form-select-sm w-auto" aria-label="Priority">
                    @foreach (TaskPriority priority in Display.Priorities)
                    {
                        <option value="@priority" selected="@(priority == task.Priority)">@Display.Priority(priority)</option>
                    }
                </select>
                <input type="date" name="dueDate" value="@Display.DateInput(task.DueDate)" class="form-control form-control-sm w-auto" aria-label="Expected delivery date" title="Expected delivery date" />
                <input type="number" name="estimateHours" value="@Display.NumberInput(task.EstimateHours)" class="form-control form-control-sm hours-input" min="0.25" step="0.25" placeholder="hrs" aria-label="Rough size in hours" />
                <button type="submit" class="btn btn-sm btn-primary">Save</button>
            </form>
            @if (task.IsWorkable || task.Status == WorkTaskStatus.OnHold)
            {
                <form method="post" asp-page="/Actions" asp-page-handler="Hold" class="d-flex flex-wrap gap-2 align-items-center mt-2">
                    <input type="hidden" name="id" value="@task.Id" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <input name="reason" value="@task.HoldReason" list="hold-reasons" class="form-control form-control-sm quick-title" required maxlength="200"
                           placeholder="Why is it on hold? e.g. AWAITING FEEDBACK FROM ..." aria-label="Hold reason" autocomplete="off" />
                    <input type="date" name="checkBackOn" value="@Display.DateInput(task.HoldCheckBackOn)" class="form-control form-control-sm w-auto" aria-label="Check back on" title="Check back on" />
                    <label class="small text-nowrap"><input type="checkbox" name="rememberReason" value="true" class="form-check-input" /> remember this reason</label>
                    <button type="submit" class="btn btn-sm btn-secondary">@holdButton</button>
                </form>
            }
            <div class="d-flex flex-wrap gap-3 align-items-center mt-2">
                <a asp-page="/History" asp-route-id="@task.Id" class="small">History</a>
                <form method="post" asp-page="/Actions" asp-page-handler="Delete" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="hidden" name="id" value="@task.Id" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <label class="small text-nowrap"><input type="checkbox" name="confirmDelete" value="true" class="form-check-input" required /> delete for good (created by mistake)</label>
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </div>
        </details>
    }
</li>
