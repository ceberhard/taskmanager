@model TaskRowModel
@{
    WorkTask task = Model.Task;
}
<li class="task-row @(task.Status == WorkTaskStatus.InProgress ? "in-progress" : "")">
    <form method="post" class="d-flex flex-wrap gap-2 align-items-start">
        <input type="hidden" name="id" value="@task.Id" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <span class="prio @Display.PriorityCss(task.Priority)">@Display.Priority(task.Priority)</span>
        <div class="flex-grow-1">
            <div class="task-title @(task.IsOpen ? "" : "text-decoration-line-through text-muted")">@Display.Linkify(task.Title)</div>
            <div class="task-meta">
                @if (Model.ShowProject)
                {
                    <span>@(task.Project?.Name ?? "Unfiled")</span>
                    <span> · </span>
                }
                <span>@Display.Status(task.Status)</span>
                @if (task.EstimateHours is double hours)
                {
                    <span> · @Display.Hours(hours)</span>
                }
                else if (task.IsOpen)
                {
                    <span> · unsized</span>
                }
                @if (task.DueDate is DateOnly due)
                {
                    <span class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")"> · due @due.ToString("ddd d MMM")</span>
                }
                @if (task.Source != TaskSource.Manual)
                {
                    <span> · @task.Source.ToString().ToLowerInvariant()</span>
                }
                @if (task.IsOpen && Model.IsPlannedToday)
                {
                    <span class="text-primary"> · planned today</span>
                }
                @if (Model.IsCarriedOver)
                {
                    <span class="text-danger"> · carried over from @task.PlannedFor!.Value.ToString("ddd d MMM")</span>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-1">
            @if (task.IsOpen)
            {
                <button type="submit" asp-page="/Actions" asp-page-handler="Complete" class="btn btn-sm btn-success">Done</button>
                @if (!Model.IsPlannedToday)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="PlanToday" class="btn btn-sm btn-outline-primary">Today</button>
                }
                @if (task.PlannedFor is not null)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="ToBacklog" class="btn btn-sm btn-outline-secondary">Backlog</button>
                }
                @if (task.Status == WorkTaskStatus.ToDo)
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="Start" class="btn btn-sm btn-outline-secondary">Start</button>
                }
                else
                {
                    <button type="submit" asp-page="/Actions" asp-page-handler="Pause" class="btn btn-sm btn-outline-secondary">Pause</button>
                }
                <button type="submit" asp-page="/Actions" asp-page-handler="Drop" class="btn btn-sm btn-outline-danger" title="Close without doing it">Drop</button>
            }
            else
            {
                <button type="submit" asp-page="/Actions" asp-page-handler="Reopen" class="btn btn-sm btn-outline-secondary">Reopen</button>
            }
        </div>
    </form>
    @if (task.IsOpen)
    {
        <details>
            <summary>Edit</summary>
            <form method="post" asp-page="/Actions" asp-page-handler="Edit" class="d-flex flex-wrap gap-2 align-items-center mt-1">
                <input type="hidden" name="id" value="@task.Id" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input name="title" value="@task.Title" class="form-control form-control-sm quick-title" required maxlength="1000" aria-label="Task title" />
                <select name="projectId" class="form-select form-select-sm w-auto" aria-label="Project">
                    <option value="">Unfiled</option>
                    @foreach (Project project in Model.Projects)
                    {
                        <option value="@project.Id" selected="@(project.Id == task.ProjectId)">@project.Name</option>
                    }
                </select>
                <select name="priority" class="form-select form-select-sm w-auto" aria-label="Priority">
                    @foreach (TaskPriority priority in Display.Priorities)
                    {
                        <option value="@priority" selected="@(priority == task.Priority)">@Display.Priority(priority)</option>
                    }
                </select>
                <input type="date" name="dueDate" value="@Display.DateInput(task.DueDate)" class="form-control form-control-sm w-auto" aria-label="Expected delivery date" title="Expected delivery date" />
                <input type="number" name="estimateHours" value="@Display.NumberInput(task.EstimateHours)" class="form-control form-control-sm hours-input" min="0.25" step="0.25" placeholder="hrs" aria-label="Rough size in hours" />
                <button type="submit" class="btn btn-sm btn-primary">Save</button>
            </form>
        </details>
    }
</li>
