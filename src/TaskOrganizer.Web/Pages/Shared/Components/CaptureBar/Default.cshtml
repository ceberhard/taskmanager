@using TaskOrganizer.Web.Domain
@using TaskOrganizer.Web.Pages
@model TaskOrganizer.Web.ViewComponents.CaptureBarModel
@{
    QuickAddDraft? draft = Model.Draft;
    string selectedPriority = draft?.Priority ?? TaskPriority.Medium.ToString();
}

<div class="capture-bar border-bottom bg-light py-2 mb-3" id="capture-bar"
     data-time-refresh-seconds="@(Model.Clock.RunningEntry is null ? 0 : Model.TimeRefreshSeconds)">
    <div class="container d-flex flex-wrap gap-2 align-items-center">
        <form method="post" asp-page="/Actions" asp-page-handler="Add" class="d-flex flex-wrap gap-2 flex-grow-1 align-items-center">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input id="quick-title" name="title" value="@draft?.Title" class="form-control form-control-sm quick-title @(draft is null ? "" : "is-invalid")" required maxlength="1000"
                   aria-describedby="@(draft is null ? null : "quick-add-error")"
                   placeholder="Add a task and press Enter  (press / to jump here)" autocomplete="off" aria-label="Task title"
                   autofocus="@(Model.FocusQuickAdd ? "autofocus" : null)" />
            <select name="projectId" class="form-select form-select-sm w-auto" aria-label="Project">
                <option value="">Unfiled</option>
                @foreach (Project project in Model.Projects)
                {
                    <option value="@project.Id" selected="@(draft?.ProjectId == project.Id.ToString())">@project.Name</option>
                }
            </select>
            <select name="priority" class="form-select form-select-sm w-auto" aria-label="Priority">
                @foreach (TaskPriority priority in Display.Priorities)
                {
                    <option value="@priority" selected="@(priority.ToString() == selectedPriority)">@Display.Priority(priority)</option>
                }
            </select>
            <input type="date" name="dueDate" value="@draft?.DueDate" class="form-control form-control-sm w-auto" aria-label="Expected delivery date" title="Expected delivery date" />
            <input type="number" name="estimateHours" value="@draft?.EstimateHours" class="form-control form-control-sm hours-input" min="0.25" step="0.25" placeholder="hrs" aria-label="Rough size in hours" title="Rough size in hours" />
            <label class="form-check-label small text-nowrap"><input type="checkbox" name="planForToday" value="true" class="form-check-input" checked="@(draft?.PlanForToday == true)" /> today</label>
            <button type="submit" class="btn btn-sm btn-primary">Add</button>
            @* Same form, so an interruption takes whatever was typed; with nothing typed it is a timestamped placeholder. *@
            <button type="submit" asp-page="/Actions" asp-page-handler="Interrupt" formnovalidate class="btn btn-sm btn-warning" accesskey="i"
                    title="Log an interruption now, using anything typed in these fields (Alt+I)">Interruption</button>
            @if (draft is not null)
            {
                <div id="quick-add-error" class="w-100 text-danger small fw-semibold" role="alert">Not added: @draft.Error</div>
            }
        </form>

        <form method="post" asp-page="/Actions" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            @if (Model.Clock.RunningEntry is not null)
            {
                <span class="small text-success text-nowrap">In since @Display.TimeInput(Model.Clock.RunningEntry.StartTime) · <span data-live-time="today">@Display.Hours(Model.Clock.TodayHours)</span></span>
                <button type="submit" asp-page="/Actions" asp-page-handler="ClockOut" class="btn btn-sm btn-outline-secondary">Clock out</button>
            }
            else if (Model.Clock.StaleOpenEntry is not null)
            {
                <a asp-page="/Time" asp-route-week="@Display.DateInput(Model.Clock.StaleOpenEntry.Date)" class="small text-danger text-nowrap">Open entry from @Model.Clock.StaleOpenEntry.Date.ToString("ddd d MMM") needs an end time</a>
            }
            else
            {
                <span class="small text-muted text-nowrap"><span data-live-time="today">@Display.Hours(Model.Clock.TodayHours)</span> today</span>
                <button type="submit" asp-page="/Actions" asp-page-handler="ClockIn" class="btn btn-sm btn-outline-success">Clock in</button>
            }
        </form>
    </div>
    <div class="container mt-2">
        <form method="post" asp-page="/Actions" asp-page-handler="Fetch" class="d-flex flex-wrap gap-2 align-items-center" id="fetch-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input name="reference" class="form-control form-control-sm fetch-input" required maxlength="2000" autocomplete="off"
                   placeholder="Jira key or PR number, e.g. ROC-4698 or 26512 (several allowed, or paste a link)" aria-label="Jira key or PR number" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Add from Jira / PR</button>
        </form>
    </div>
</div>
<datalist id="hold-reasons">
    @foreach (HoldReasonSuggestion reason in Model.HoldReasons)
    {
        <option value="@reason.Text"></option>
    }
</datalist>
